{
  "code": {
    "displayName": "Coding Agent",
    "agentDir": "~/.pi/agent",
    "instructions": "profiles/code/AGENTS.md",
    "packages": ["platform"]
  },
  "everyday": {
    "displayName": "Everyday Agent",
    "agentDir": "~/.pi/agents/everyday",
    "instructions": "profiles/everyday/AGENTS.md",
    "defaultCwd": "~",
    "cwdEnv": "PI_EVERYDAY_CWD",
    "packages": ["platform"]
  },
  "print": {
    "displayName": "3D Print Agent",
    "agentDir": "~/.pi/agents/print",
    "instructions": "profiles/print/AGENTS.md",
    "packages": ["platform", "print"]
  },
  "proxmox": {
    "displayName": "Proxmox Agent",
    "agentDir": "~/.pi/agents/proxmox",
    "instructions": "profiles/proxmox/AGENTS.md",
    "defaultCwd": "~/omega/Code/homelab",
    "cwdEnv": "PI_PROXMOX_CWD",
    "packages": ["platform", "proxmox"]
  }
}
